# PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/al_ruboui_pharmacy?sslmode=require"

# Generate a random secret of at least 32 characters for production sessions.
AUTH_SECRET="replace-with-a-long-random-secret"

# One-time owner bootstrap only. Supply through a secure environment, never source control.
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME=""

# AL-RABUOI assistant. Add real values only in hosting environment variables / GitHub Secrets.
# Never commit API keys or paste them into source files.
AL_RABUOI_AI_PROVIDER=""
AL_RABUOI_AI_API_KEY=""
AL_RABUOI_AI_BASE_URL=""
AL_RABUOI_AI_MODEL=""

# Other integrations. Leave unset until official access and credentials are available.
ALJAIB_API_BASE_URL=""
ALJAIB_API_KEY=""
FLOUSAK_API_BASE_URL=""
FLOUSAK_API_KEY=""
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
